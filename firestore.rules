rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 0. AUTHENTICATION BASELINE & HELPERS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // In our system, roles might be on the JWT token (custom claims) or in the users collection.
    // Assuming custom claims if possible, or defaulting to a user document read.
    function getUserRole() {
      return request.auth.token.role; // Needs custom claims
      // Fallback if custom claims aren't used: get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
    }

    // Role Checks
    function isStudent() { return getUserRole() in ['STUDENT_GENERAL', 'STUDENT_ORGANIZER']; }
    function isOrganizer() { return getUserRole() == 'STUDENT_ORGANIZER'; }
    function isFaculty() { return getUserRole() == 'FACULTY'; }
    function isHOD() { return getUserRole() == 'HOD'; }
    function isIQAC() { return getUserRole() == 'IQAC_TEAM'; }
    function isAdmin() { return getUserRole() == 'SYSTEM_ADMIN'; }

    function isEventOwner(eventData) {
      return isAuthenticated() && eventData.ownerId == request.auth.uid;
    }
    
    function isEventManager(eventData) {
      // Requires eventData to have a 'managers' array containing user UIDs
      return isAuthenticated() && request.auth.uid in eventData.managers;
    }

    // ==========================================
    // 1. EVENTS (STUDENT & ORGANIZER PERMISSIONS)
    // ==========================================
    match /events/{eventId} {
      // Read: Any authenticated user can read events (required for dashboard/explore).
      // In a strict environment, we'd limit this to published events or their own.
      allow read: if isAuthenticated();
      
      // Create: Students/Organizers can create, but must assign themselves as owner
      allow create: if isAuthenticated() 
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'DRAFT'; // Cannot create directly into PENDING

      // Update: Student/Organizer cannot modify another's event, and cannot bypass workflow states
      allow update: if isAuthenticated()
                    && (isEventOwner(resource.data) || isEventManager(resource.data) || isAdmin())
                    // Block state bypass: Clients cannot change status or approval history directly.
                    // Must be done via Backend API.
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                        ['status', 'workflowState', 'approvedBy', 'iqacApprovedAt']
                    );
                    
      allow delete: if false; // Deletions handled by backend via soft delete/archiving
    }

    // ==========================================
    // 2. VENUES & RESERVATIONS
    // ==========================================
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Only admins manage venues
    }
    
    match /venueReservations/{resId} {
      allow read: if isAuthenticated();
      // Reservation documents cannot be modified by unauthorized users
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only backend updates reservations (status change) or the owner modifying date
      allow update: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']);
      allow delete: if false;
    }

    // ==========================================
    // 3. SYSTEM LOGS (IQAC PERMISSIONS)
    // ==========================================
    match /eventAuditLogs/{logId} {
      // IQAC-only collections cannot be read by organizers.
      // Audit logs are append-only.
      allow read: if isIQAC() || isAdmin();
      allow create: if isIQAC() || isAdmin(); // Normally backend-only
      allow update, delete: if false; // Strictly append-only
    }
    
    match /eventActivity/{logId} {
      allow read: if isAuthenticated(); 
      allow create: if isAuthenticated(); 
      allow update, delete: if false; // Append-only
    }
    
    match /auditLogs/{logId} {
      allow read: if isIQAC() || isAdmin();
      allow write: if false; // Backend only
    }

    // ==========================================
    // 4. USERS & PROFILES (CROSS-ROLE VALIDATION)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Block privilege escalation: Users cannot modify their role or department
      allow update: if request.auth.uid == userId 
                   && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                        ['role', 'department', 'isApprovedOrganizer', 'email']
                   );
      allow create, delete: if false; // Managed by backend Auth triggers
    }

    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed via SIS / Backend sync
    }
    
    // ==========================================
    // 5. EVENT SUB-DOCS (Media, Feedback, Attendance)
    // ==========================================
    match /eventDocuments/{docId} {
      allow read: if isAuthenticated();
      // Must be managed by backend to verify ENDED state
      allow write: if false;
    }
    match /eventAttendance/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /eventFeedback/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ==========================================
    // 6. DEFAULT DENY
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
